		<PackageReference Include="Hangfire.MemoryStorage" Version="1.7.0" />
		<PackageReference Include="Hangfire.SqlServer" Version="1.7.17" />

		<!-- PDF Generation -->
		<PackageReference Include="itext7" Version="8.*" />
		<PackageReference Include="itext7.pdfhtml" Version="5.*" />
		<!-- Required at runtime by iText 8 for hashing/crypto (document ID, etc.); without it PDF creation throws "Unknown PdfException". -->
