		<PackageReference Include="NUglify" Version="1.20.7" />
		<PackageReference Include="HtmlAgilityPack" Version="1.11.52" />
		<PackageReference Include="MediatR" Version="10.0.1" />

		<!-- Barcode/QR -->
		<PackageReference Include="BarCode" Version="2023.1.11395" />
		<PackageReference Include="QRCoder" Version="1.4.1" />

		<!-- Images -->
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.8" />

		<!-- API Documentation -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="6.2.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.2.3" />
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />

		<!-- Security -->
		<PackageReference Include="NWebsec.AspNetCore.Middleware" Version="3.0.0" />
		<PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />

		<!-- External Services -->
		<PackageReference Include="FirebaseAdmin" Version="3.0.1" />
		<PackageReference Include="AppleAuth.NET" Version="1.0.8" />
		<PackageReference Include="Google.Cloud.Storage.V1" Version="4.10.0" />
		<PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.15.8" />
